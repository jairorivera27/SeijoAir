<footer style="background: var(--gray-dark); color: var(--white); padding: 3rem 0 1.5rem;">
	<div class="container">
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-bottom: 2rem;">
			<div>
				<img src="/seijo air.png" alt="Seijo Air" style="height: 50px; width: auto; margin-bottom: 1rem; filter: brightness(0) invert(1);" />
				<p style="color: var(--gray-medium); margin-bottom: 1rem;">Ingeniería en el Aire</p>
				<p style="color: var(--gray-medium); font-size: 0.9rem;">Soluciones profesionales en ventilación, HVAC, refrigeración y calidad de aire interior.</p>
			</div>
			
			<div>
				<h3 style="margin-bottom: 1rem; font-size: 1.2rem;">Servicios</h3>
				<ul style="list-style: none; color: var(--gray-medium);">
					<li style="margin-bottom: 0.5rem;"><a href="/servicios/ventilacion" style="color: var(--gray-medium); text-decoration: none;">Ventilación Industrial</a></li>
					<li style="margin-bottom: 0.5rem;"><a href="/servicios/purificacion" style="color: var(--gray-medium); text-decoration: none;">Purificación de Aire</a></li>
					<li style="margin-bottom: 0.5rem;"><a href="/servicios/hvac" style="color: var(--gray-medium); text-decoration: none;">HVAC & Confort</a></li>
					<li style="margin-bottom: 0.5rem;"><a href="/servicios/refrigeracion" style="color: var(--gray-medium); text-decoration: none;">Refrigeración</a></li>
				</ul>
			</div>
			
			<div>
				<h3 style="margin-bottom: 1rem; font-size: 1.2rem;">Empresa</h3>
				<ul style="list-style: none; color: var(--gray-medium);">
					<li style="margin-bottom: 0.5rem;"><a href="/nosotros" style="color: var(--gray-medium); text-decoration: none;">Nosotros</a></li>
					<li style="margin-bottom: 0.5rem;"><a href="/servicios" style="color: var(--gray-medium); text-decoration: none;">Todos los Servicios</a></li>
					<li style="margin-bottom: 0.5rem;"><a href="/testimonios" style="color: var(--gray-medium); text-decoration: none;">Testimonios</a></li>
					<li style="margin-bottom: 0.5rem;"><a href="/blog" style="color: var(--gray-medium); text-decoration: none;">Blog</a></li>
					<li style="margin-bottom: 0.5rem;"><a href="/contacto" style="color: var(--gray-medium); text-decoration: none;">Contacto</a></li>
				</ul>
			</div>
			
			<div>
				<h3 style="margin-bottom: 1rem; font-size: 1.2rem;">Contacto</h3>
				<p style="color: var(--gray-medium); margin-bottom: 0.5rem;">Email: info@seijoair.com</p>
				<p style="color: var(--gray-medium); margin-bottom: 0.5rem;">Teléfono: +57 (1) 234-5678</p>
				<p style="color: var(--gray-medium); margin-bottom: 1rem;">Celular: +57 300 123-4567</p>
				
				<h3 style="margin-bottom: 1rem; font-size: 1.2rem; margin-top: 1.5rem;">Síguenos</h3>
				<div style="display: flex; gap: 1rem;">
					<a href="#" style="color: var(--gray-medium); text-decoration: none; font-size: 1.5rem; transition: color 0.3s;" title="Facebook">📘</a>
					<a href="#" style="color: var(--gray-medium); text-decoration: none; font-size: 1.5rem; transition: color 0.3s;" title="LinkedIn">💼</a>
					<a href="#" style="color: var(--gray-medium); text-decoration: none; font-size: 1.5rem; transition: color 0.3s;" title="Instagram">📷</a>
					<a href="#" style="color: var(--gray-medium); text-decoration: none; font-size: 1.5rem; transition: color 0.3s;" title="YouTube">📺</a>
				</div>
			</div>
		</div>
		
		<div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1.5rem;">
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; margin-bottom: 1.5rem;">
				<div>
					<h4 style="margin-bottom: 0.75rem; font-size: 1rem;">Certificaciones</h4>
					<div style="display: flex; flex-direction: column; gap: 0.5rem;">
						<p style="color: var(--gray-medium); font-size: 0.85rem;">✓ ISO 9001:2015</p>
						<p style="color: var(--gray-medium); font-size: 0.85rem;">✓ ASHRAE Member</p>
						<p style="color: var(--gray-medium); font-size: 0.85rem;">✓ Certificado Ambiental</p>
					</div>
				</div>
				<div>
					<h4 style="margin-bottom: 0.75rem; font-size: 1rem;">Descargas</h4>
					<div style="display: flex; flex-direction: column; gap: 0.5rem;">
						<a href="#" style="color: var(--gray-medium); text-decoration: none; font-size: 0.85rem;">📄 Catálogo de Servicios</a>
						<a href="#" style="color: var(--gray-medium); text-decoration: none; font-size: 0.85rem;">📄 Brochure Corporativo</a>
						<a href="#" style="color: var(--gray-medium); text-decoration: none; font-size: 0.85rem;">📄 Certificaciones</a>
					</div>
				</div>
			</div>
			<div style="text-align: center; color: var(--gray-medium); font-size: 0.9rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.1);">
				<p>&copy; 2024 Seijo Air. Todos los derechos reservados. | Ingeniería en el Aire</p>
			</div>
		</div>
	</div>
</footer>

<style>
	footer a:hover {
		color: var(--teal-light) !important;
	}
	
	footer a[title]:hover {
		transform: scale(1.2);
		transition: transform 0.3s;
	}
</style>

