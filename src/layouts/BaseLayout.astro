---
interface Props {
	title: string;
	description?: string;
	keywords?: string;
	image?: string;
	canonical?: string;
	type?: string;
	robots?: string;
}

const { 
	title, 
	description = "Seijo Air - Líderes en Ingeniería del Aire. Soluciones profesionales en ventilación industrial, HVAC, refrigeración, purificación de aire y calidad de aire interior en Colombia. Más de 15 años de experiencia.",
	keywords = "ventilación industrial, HVAC, refrigeración comercial, purificación de aire, calidad de aire interior, extracción de aire, sistemas de ventilación, aire acondicionado, cuartos fríos, precipitadores electrostáticos, Colombia",
	image = "/seijo air.png",
	canonical = Astro.url.pathname,
	type = "website",
	robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
} = Astro.props;

const siteUrl = Astro.site?.href || "https://seijoair.com";
const fullImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
const fullCanonical = canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`;
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;

// Schema.org JSON-LD
const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"name": "Seijo Air",
	"alternateName": "Seijo Air - Ingeniería en el Aire",
	"url": siteUrl,
	"logo": `${siteUrl}/seijo air.png`,
	"description": description,
	"address": {
		"@type": "PostalAddress",
		"addressCountry": "CO",
		"addressLocality": "Colombia"
	},
	"contactPoint": {
		"@type": "ContactPoint",
		"telephone": "+57-1-234-5678",
		"contactType": "customer service",
		"email": "info@seijoair.com",
		"availableLanguage": ["Spanish", "English"]
	},
	"sameAs": [
		"https://www.facebook.com/seijoair",
		"https://www.linkedin.com/company/seijoair",
		"https://www.instagram.com/seijoair"
	],
	"areaServed": {
		"@type": "Country",
		"name": "Colombia"
	},
	"knowsAbout": [
		"Ventilación Industrial",
		"HVAC",
		"Refrigeración Comercial",
		"Purificación de Aire",
		"Calidad de Aire Interior",
		"Ingeniería del Aire"
	]
};

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"@id": `${siteUrl}#organization`,
	"name": "Seijo Air",
	"image": `${siteUrl}/seijo air.png`,
	"description": description,
	"url": siteUrl,
	"telephone": "+57-1-234-5678",
	"email": "info@seijoair.com",
	"priceRange": "$$",
	"address": {
		"@type": "PostalAddress",
		"addressCountry": "CO"
	},
	"geo": {
		"@type": "GeoCoordinates",
		"addressCountry": "CO"
	},
	"openingHoursSpecification": {
		"@type": "OpeningHoursSpecification",
		"dayOfWeek": [
			"Monday",
			"Tuesday",
			"Wednesday",
			"Thursday",
			"Friday"
		],
		"opens": "08:00",
		"closes": "18:00"
	},
	"areaServed": {
		"@type": "Country",
		"name": "Colombia"
	}
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		
		<!-- Primary Meta Tags -->
		<title>{title} | Seijo Air - Ingeniería en el Aire</title>
		<meta name="title" content={`${title} | Seijo Air`} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="Seijo Air" />
		<meta name="robots" content={robots} />
		<meta name="language" content="Spanish" />
		<meta name="revisit-after" content="7 days" />
		<meta name="distribution" content="global" />
		<meta name="rating" content="general" />
		
		<!-- Canonical URL -->
		<link rel="canonical" href={fullCanonical} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={fullCanonical} />
		<meta property="og:title" content={`${title} | Seijo Air`} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={fullImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Seijo Air - Ingeniería en el Aire" />
		<meta property="og:site_name" content="Seijo Air" />
		<meta property="og:locale" content="es_CO" />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={fullCanonical} />
		<meta name="twitter:title" content={`${title} | Seijo Air`} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={fullImageUrl} />
		<meta name="twitter:image:alt" content="Seijo Air - Ingeniería en el Aire" />
		<meta name="twitter:creator" content="@seijoair" />
		<meta name="twitter:site" content="@seijoair" />
		
		<!-- Favicon -->
		<link rel="icon" type="image/png" href="/seijo air.png" />
		<link rel="apple-touch-icon" href="/seijo air.png" />
		
		<!-- Generator -->
		<meta name="generator" content={Astro.generator} />
		
		<!-- Schema.org JSON-LD -->
		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}
			
			:root {
				--primary-blue: #1e40af;
				--primary-blue-light: #3b82f6;
				--primary-blue-dark: #1e3a8a;
				--teal: #14b8a6;
				--teal-light: #5eead4;
				--gray-dark: #1f2937;
				--gray-medium: #6b7280;
				--gray-light: #f3f4f6;
				--white: #ffffff;
			}
			
			body {
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
				color: var(--gray-dark);
				line-height: 1.6;
				background-color: var(--white);
			}
			
			.container {
				max-width: 1200px;
				margin: 0 auto;
				padding: 0 1.5rem;
			}
			
			.btn {
				display: inline-block;
				padding: 0.75rem 1.5rem;
				border-radius: 0.5rem;
				text-decoration: none;
				font-weight: 600;
				transition: all 0.3s ease;
				border: none;
				cursor: pointer;
			}
			
			.btn-primary {
				background: linear-gradient(135deg, var(--primary-blue), var(--primary-blue-light));
				color: var(--white);
			}
			
			.btn-primary:hover {
				background: linear-gradient(135deg, var(--primary-blue-dark), var(--primary-blue));
				transform: translateY(-2px);
				box-shadow: 0 4px 12px rgba(30, 64, 175, 0.3);
			}
			
			.btn-secondary {
				background: transparent;
				color: var(--primary-blue);
				border: 2px solid var(--primary-blue);
			}
			
			.btn-secondary:hover {
				background: var(--primary-blue);
				color: var(--white);
			}
			
			section {
				padding: 4rem 0;
			}
			
			.section-title {
				font-size: 2.5rem;
				font-weight: 700;
				margin-bottom: 1rem;
				color: var(--gray-dark);
			}
			
			.section-subtitle {
				font-size: 1.25rem;
				color: var(--gray-medium);
				margin-bottom: 3rem;
			}
			
			@media (max-width: 768px) {
				.section-title {
					font-size: 2rem;
				}
				
				section {
					padding: 2.5rem 0;
				}
			}
		</style>
	</head>
	<body>
		<slot />
	</body>
</html>

