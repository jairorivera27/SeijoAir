---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Sistemas Evaporativos">
	<Header />
	
	<section style="background: linear-gradient(135deg, var(--primary-blue) 0%, var(--teal) 100%); color: var(--white); padding: 4rem 0;">
		<div class="container">
			<h1 class="section-title" style="color: var(--white);">Sistemas Evaporativos</h1>
			<p class="section-subtitle" style="color: rgba(255,255,255,0.9);">Enfriamiento eficiente con bajo consumo energético</p>
		</div>
	</section>
	
	<section>
		<div class="container">
			<div style="max-width: 900px; margin: 0 auto;">
				<div style="margin-bottom: 3rem;">
					<h2 style="font-size: 2rem; margin-bottom: 1.5rem; color: var(--primary-blue);">Enfriamiento Evaporativo</h2>
					<p style="color: var(--gray-medium); line-height: 1.8; margin-bottom: 1rem;">
						Los sistemas evaporativos aprovechan el principio natural de evaporación del agua para reducir la temperatura del aire de manera eficiente y económica:
					</p>
					<ul style="color: var(--gray-medium); line-height: 1.8; margin-left: 2rem; margin-bottom: 1.5rem;">
						<li>Reducción de temperatura de 5°C a 12°C según condiciones ambientales</li>
						<li>Consumo energético hasta 80% menor que sistemas de aire acondicionado convencional</li>
						<li>Ideal para espacios grandes como naves industriales, talleres y almacenes</li>
						<li>Mejora de calidad del aire mediante humidificación controlada</li>
						<li>Ventilación continua con aire fresco del exterior</li>
					</ul>
				</div>
				
				<div style="margin-bottom: 3rem;">
					<h2 style="font-size: 2rem; margin-bottom: 1.5rem; color: var(--primary-blue);">Suministro e Instalación</h2>
					<p style="color: var(--gray-medium); line-height: 1.8; margin-bottom: 1rem;">
						Ofrecemos servicios completos para sistemas evaporativos:
					</p>
					<ul style="color: var(--gray-medium); line-height: 1.8; margin-left: 2rem; margin-bottom: 1.5rem;">
						<li><strong>Pads evaporativos:</strong> Paneles de alta eficiencia con diferentes materiales (celulosa, fibra de vidrio)</li>
						<li><strong>Bombas de recirculación:</strong> Sistemas de bombeo para distribución uniforme de agua</li>
						<li><strong>Control de caudal:</strong> Válvulas, flotadores y sistemas de control para operación óptima</li>
						<li><strong>Ventiladores:</strong> Equipos de alta eficiencia para movimiento de aire</li>
						<li><strong>Instalación profesional:</strong> Montaje, conexiones y puesta en marcha garantizada</li>
					</ul>
				</div>
				
				<div style="background: var(--gray-light); padding: 2rem; border-radius: 1rem; margin-top: 3rem;">
					<h3 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--primary-blue);">Aplicaciones Ideales</h3>
					<ul style="color: var(--gray-medium); line-height: 1.8; margin-left: 2rem;">
						<li>Naves industriales y talleres</li>
						<li>Almacenes y centros de distribución</li>
						<li>Invernaderos y agricultura</li>
						<li>Espacios deportivos y recreativos</li>
						<li>Establos y granjas</li>
					</ul>
				</div>
			</div>
		</div>
	</section>
	
	<section style="background: var(--gray-light);">
		<div class="container" style="text-align: center;">
			<h2 style="font-size: 2rem; margin-bottom: 1rem;">¿Necesita un sistema evaporativo?</h2>
			<p style="color: var(--gray-medium); margin-bottom: 2rem;">Contáctenos para evaluación y cotización</p>
			<a href="/contacto" class="btn btn-primary">Solicitar Cotización</a>
		</div>
	</section>
	
	<Footer />
</BaseLayout>

