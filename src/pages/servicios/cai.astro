---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Calidad de Aire Interior (CAI) & Cumplimiento">
	<Header />
	
	<section style="background: linear-gradient(135deg, var(--primary-blue) 0%, var(--teal) 100%); color: var(--white); padding: 4rem 0;">
		<div class="container">
			<h1 class="section-title" style="color: var(--white);">Calidad de Aire Interior (CAI) & Cumplimiento</h1>
			<p class="section-subtitle" style="color: rgba(255,255,255,0.9);">Diagnóstico, medición y mejora de calidad del aire</p>
		</div>
	</section>
	
	<section>
		<div class="container">
			<div style="max-width: 900px; margin: 0 auto;">
				<div style="margin-bottom: 3rem;">
					<h2 style="font-size: 2rem; margin-bottom: 1.5rem; color: var(--primary-blue);">Diagnóstico CAI</h2>
					<p style="color: var(--gray-medium); line-height: 1.8; margin-bottom: 1rem;">
						Evaluación completa de la calidad del aire interior mediante mediciones precisas:
					</p>
					<ul style="color: var(--gray-medium); line-height: 1.8; margin-left: 2rem; margin-bottom: 1.5rem;">
						<li><strong>CO₂ (Dióxido de Carbono):</strong> Medición de niveles para evaluar ventilación y ocupación</li>
						<li><strong>PM (Material Particulado):</strong> Análisis de partículas PM2.5 y PM10 según normativas</li>
						<li><strong>VOC (Compuestos Orgánicos Volátiles):</strong> Detección de contaminantes químicos en el aire</li>
						<li><strong>Temperatura y Humedad:</strong> Monitoreo de condiciones térmicas y de confort</li>
						<li>Equipos de medición certificados y calibrados</li>
						<li>Reportes técnicos detallados con comparación normativa</li>
					</ul>
				</div>
				
				<div style="margin-bottom: 3rem;">
					<h2 style="font-size: 2rem; margin-bottom: 1.5rem; color: var(--primary-blue);">Planes de Mejora</h2>
					<p style="color: var(--gray-medium); line-height: 1.8; margin-bottom: 1rem;">
						Desarrollo e implementación de estrategias para mejorar la calidad del aire:
					</p>
					<ul style="color: var(--gray-medium); line-height: 1.8; margin-left: 2rem; margin-bottom: 1.5rem;">
						<li><strong>Ventilación:</strong> Optimización de tasas de renovación de aire y sistemas de ventilación</li>
						<li><strong>Filtración:</strong> Selección e implementación de sistemas de filtración adecuados</li>
						<li><strong>Sellos de infiltración:</strong> Identificación y corrección de puntos de entrada de aire no controlado</li>
						<li>Control de fuentes de contaminación</li>
						<li>Mejora de distribución de aire</li>
						<li>Implementación de tecnologías de purificación</li>
					</ul>
				</div>
				
				<div style="margin-bottom: 3rem;">
					<h2 style="font-size: 2rem; margin-bottom: 1.5rem; color: var(--primary-blue);">Cumplimiento Normativo</h2>
					<p style="color: var(--gray-medium); line-height: 1.8; margin-bottom: 1rem;">
						Asesoría y certificación para cumplimiento de normas y estándares:
					</p>
					<ul style="color: var(--gray-medium); line-height: 1.8; margin-left: 2rem; margin-bottom: 1.5rem;">
						<li>Normas ASHRAE (American Society of Heating, Refrigerating and Air-Conditioning Engineers)</li>
						<li>Estándares ISO para calidad de aire</li>
						<li>Regulaciones locales y nacionales</li>
						<li>Normativas específicas por sector (salud, educación, industria)</li>
						<li>Documentación y certificaciones</li>
					</ul>
				</div>
				
				<div style="background: var(--gray-light); padding: 2rem; border-radius: 1rem; margin-top: 3rem;">
					<h3 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--primary-blue);">Beneficios</h3>
					<ul style="color: var(--gray-medium); line-height: 1.8; margin-left: 2rem;">
						<li>Mejora de salud y bienestar de ocupantes</li>
						<li>Reducción de ausentismo laboral</li>
						<li>Mayor productividad y confort</li>
						<li>Cumplimiento legal y normativo</li>
						<li>Certificaciones y documentación técnica</li>
					</ul>
				</div>
			</div>
		</div>
	</section>
	
	<section style="background: var(--gray-light);">
		<div class="container" style="text-align: center;">
			<h2 style="font-size: 2rem; margin-bottom: 1rem;">¿Necesita una evaluación CAI?</h2>
			<p style="color: var(--gray-medium); margin-bottom: 2rem;">Contáctenos para diagnóstico y plan de mejora</p>
			<a href="/contacto" class="btn btn-primary">Solicitar Evaluación</a>
		</div>
	</section>
	
	<Footer />
</BaseLayout>

