---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Seguridad y Control de Olores">
	<Header />
	
	<section style="background: linear-gradient(135deg, var(--primary-blue) 0%, var(--teal) 100%); color: var(--white); padding: 4rem 0;">
		<div class="container">
			<h1 class="section-title" style="color: var(--white);">Seguridad y Control de Olores</h1>
			<p class="section-subtitle" style="color: rgba(255,255,255,0.9);">Soluciones para captación y eliminación de olores y gases</p>
		</div>
	</section>
	
	<section>
		<div class="container">
			<div style="max-width: 900px; margin: 0 auto;">
				<div style="margin-bottom: 3rem;">
					<h2 style="font-size: 2rem; margin-bottom: 1.5rem; color: var(--primary-blue);">Captación de Olores y Gases</h2>
					<p style="color: var(--gray-medium); line-height: 1.8; margin-bottom: 1rem;">
						Sistemas especializados para el control de olores y gases contaminantes:
					</p>
					<ul style="color: var(--gray-medium); line-height: 1.8; margin-left: 2rem; margin-bottom: 1.5rem;">
						<li><strong>Filtros de carbón activado:</strong> Absorción eficiente de olores y compuestos orgánicos volátiles (VOC)</li>
						<li><strong>Soluciones combinadas:</strong> Sistemas híbridos que combinan filtración, carbón activado y otras tecnologías</li>
						<li>Captación en el punto de origen para máxima eficiencia</li>
						<li>Diseño personalizado según tipo de contaminante y proceso</li>
						<li>Regeneración y reemplazo de medios filtrantes</li>
					</ul>
				</div>
				
				<div style="margin-bottom: 3rem;">
					<h2 style="font-size: 2rem; margin-bottom: 1.5rem; color: var(--primary-blue);">Sistemas Especiales</h2>
					<p style="color: var(--gray-medium); line-height: 1.8; margin-bottom: 1rem;">
						Aplicaciones especializadas para sectores específicos:
					</p>
					<ul style="color: var(--gray-medium); line-height: 1.8; margin-left: 2rem; margin-bottom: 1.5rem;">
						<li><strong>Cocción industrial:</strong> Sistemas de extracción y purificación para cocinas industriales, restaurantes y comedores</li>
						<li><strong>Laboratorios:</strong> Campanas de extracción y sistemas de filtración para gases químicos y vapores</li>
						<li><strong>Cocinas comerciales:</strong> Campanas de cocina con filtración de grasas y control de olores</li>
						<li>Sistemas para tratamiento de aguas residuales y plantas de proceso</li>
						<li>Aplicaciones en industria química y farmacéutica</li>
					</ul>
				</div>
				
				<div style="margin-bottom: 3rem;">
					<h2 style="font-size: 2rem; margin-bottom: 1.5rem; color: var(--primary-blue);">Tecnologías Aplicadas</h2>
					<ul style="color: var(--gray-medium); line-height: 1.8; margin-left: 2rem; margin-bottom: 1.5rem;">
						<li>Filtración de partículas y aerosoles grasos</li>
						<li>Absorción química con carbón activado</li>
						<li>Oxidación térmica y catalítica</li>
						<li>Lavadores de gases (scrubbers)</li>
						<li>Purificación UV y ozonización</li>
					</ul>
				</div>
				
				<div style="background: var(--gray-light); padding: 2rem; border-radius: 1rem; margin-top: 3rem;">
					<h3 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--primary-blue);">Beneficios</h3>
					<ul style="color: var(--gray-medium); line-height: 1.8; margin-left: 2rem;">
						<li>Eliminación efectiva de olores molestos</li>
						<li>Control de emisiones y cumplimiento ambiental</li>
						<li>Mejora del ambiente de trabajo</li>
						<li>Protección de la salud de trabajadores</li>
						<li>Prevención de quejas y conflictos vecinales</li>
					</ul>
				</div>
			</div>
		</div>
	</section>
	
	<section style="background: var(--gray-light);">
		<div class="container" style="text-align: center;">
			<h2 style="font-size: 2rem; margin-bottom: 1rem;">¿Necesita control de olores o gases?</h2>
			<p style="color: var(--gray-medium); margin-bottom: 2rem;">Contáctenos para evaluación y solución personalizada</p>
			<a href="/contacto" class="btn btn-primary">Solicitar Cotización</a>
		</div>
	</section>
	
	<Footer />
</BaseLayout>

