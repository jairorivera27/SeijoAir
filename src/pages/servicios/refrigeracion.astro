---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Refrigeración Comercial & Cuartos Fríos">
	<Header />
	
	<section style="background: linear-gradient(135deg, var(--primary-blue) 0%, var(--teal) 100%); color: var(--white); padding: 4rem 0;">
		<div class="container">
			<h1 class="section-title" style="color: var(--white);">Refrigeración Comercial & Cuartos Fríos</h1>
			<p class="section-subtitle" style="color: rgba(255,255,255,0.9);">Soluciones para conservación y congelación</p>
		</div>
	</section>
	
	<section>
		<div class="container">
			<div style="max-width: 900px; margin: 0 auto;">
				<div style="margin-bottom: 3rem;">
					<h2 style="font-size: 2rem; margin-bottom: 1.5rem; color: var(--primary-blue);">Cámaras y Cuartos Fríos</h2>
					<p style="color: var(--gray-medium); line-height: 1.8; margin-bottom: 1rem;">
						Diseño, construcción e instalación de cámaras frigoríficas para conservación y congelación a temperatura controlada:
					</p>
					<ul style="color: var(--gray-medium); line-height: 1.8; margin-left: 2rem; margin-bottom: 1.5rem;">
						<li><strong>Conservación:</strong> Cámaras de refrigeración (0°C a 4°C) para productos frescos</li>
						<li><strong>Congelación:</strong> Cámaras de congelación (-18°C a -25°C) para productos congelados</li>
						<li><strong>Ultra congelación:</strong> Sistemas para temperaturas extremas según requerimientos</li>
						<li>Paneles aislantes de alta eficiencia (poliuretano expandido)</li>
						<li>Puertas especiales con sellos herméticos y sistemas anti-condensación</li>
						<li>Control de humedad y circulación de aire optimizada</li>
					</ul>
				</div>
				
				<div style="margin-bottom: 3rem;">
					<h2 style="font-size: 2rem; margin-bottom: 1.5rem; color: var(--primary-blue);">Sistemas de Refrigeración</h2>
					<p style="color: var(--gray-medium); line-height: 1.8; margin-bottom: 1rem;">
						Equipos y sistemas completos para operación confiable:
					</p>
					<ul style="color: var(--gray-medium); line-height: 1.8; margin-left: 2rem; margin-bottom: 1.5rem;">
						<li><strong>Racks de compresión:</strong> Sistemas modulares con múltiples compresores para alta capacidad</li>
						<li><strong>Unidades condensadoras:</strong> Equipos de condensación por aire o agua, interiores o exteriores</li>
						<li><strong>Evaporadores:</strong> Unidades evaporadoras de techo, murales o de suelo según aplicación</li>
						<li>Refrigerantes ecológicos y de alta eficiencia</li>
						<li>Sistemas de control y monitoreo automatizado</li>
						<li>Redundancia y respaldo para operación continua</li>
					</ul>
				</div>
				
				<div style="margin-bottom: 3rem;">
					<h2 style="font-size: 2rem; margin-bottom: 1.5rem; color: var(--primary-blue);">Vitrinas y Equipos Comerciales</h2>
					<p style="color: var(--gray-medium); line-height: 1.8; margin-bottom: 1rem;">
						Especificación e instalación de equipos comerciales:
					</p>
					<ul style="color: var(--gray-medium); line-height: 1.8; margin-left: 2rem; margin-bottom: 1.5rem;">
						<li>Vitrinas refrigeradas y congeladoras para exhibición</li>
						<li>Muebles frigoríficos para almacenamiento</li>
						<li>Máquinas de hielo y dispensadores</li>
						<li>Equipos para restaurantes, supermercados y comercios</li>
						<li>Asesoría en selección según necesidades específicas</li>
						<li>Instalación profesional y puesta en marcha</li>
					</ul>
					<p style="color: var(--gray-medium); line-height: 1.8; font-style: italic; margin-top: 1rem;">
						Nota: Los equipos AVAS se atienden según requerimiento del cliente.
					</p>
				</div>
				
				<div style="background: var(--gray-light); padding: 2rem; border-radius: 1rem; margin-top: 3rem;">
					<h3 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--primary-blue);">Sectores de Aplicación</h3>
					<ul style="color: var(--gray-medium); line-height: 1.8; margin-left: 2rem;">
						<li>Industria alimentaria y procesamiento</li>
						<li>Supermercados y retail</li>
						<li>Restaurantes y hotelería</li>
						<li>Farmacia y productos farmacéuticos</li>
						<li>Logística y distribución</li>
					</ul>
				</div>
			</div>
		</div>
	</section>
	
	<section style="background: var(--gray-light);">
		<div class="container" style="text-align: center;">
			<h2 style="font-size: 2rem; margin-bottom: 1rem;">¿Necesita un sistema de refrigeración?</h2>
			<p style="color: var(--gray-medium); margin-bottom: 2rem;">Contáctenos para diseño y cotización</p>
			<a href="/contacto" class="btn btn-primary">Solicitar Cotización</a>
		</div>
	</section>
	
	<Footer />
</BaseLayout>

