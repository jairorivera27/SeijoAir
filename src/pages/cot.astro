		</div>
		
		<div class="payment-info">
			<p><strong>Forma de pago:</strong> 50% Anticipo - 50% Contraentrega</p>
		</div>
		
		<div class="validity-note">
			<p><strong>Nota:</strong> Esta cotización tiene validez por 30 días calendario.</p>
		</div>
		
		<div class="footer">
			<div class="footer-section">
				<h4>Ejecutivo Comercial</h4>
				<p>${asesorNombre}</p>
				<p>Tel: ${asesorTelefono}</p>
			</div>
			
			<div class="signature">
				<p>Atentamente,</p>
				<p style="margin-top: 30px;"><strong>Seijo Air</strong></p>
				<p>Ingeniería en el Aire</p>
			</div>
		</div>
		
		<img src="${baseUrl}/pie de pagina.PNG" alt="Pie de página" class="pdf-footer-image" />
	</div>
</body>
</html>`;
		}

		// Mostrar resultados
		function mostrarResultados(resultados) {
			const container = document.getElementById('resultados-container');
			const tabla = document.getElementById('tabla-costos');
			
			// Limpiar tabla
			tabla.innerHTML = '';

			// Agregar filas de servicios
			const servicios = ['precipitador', 'ventilador', 'campana', 'ducto'];
			const nombresServicios = {
				precipitador: 'Precipitador',
				ventilador: 'Ventilador',
				campana: 'Campana',
				ducto: 'Ducto'
			};

			servicios.forEach(servicio => {
				const resultado = resultados[servicio];
				if (resultado && resultado.cantidad > 0) {
					const fila = document.createElement('tr');
					fila.innerHTML = `
						<td style="padding: 1rem; border: 1px solid #e5e7eb;">${nombresServicios[servicio]}</td>
						<td style="padding: 1rem; border: 1px solid #e5e7eb; text-align: right;">${resultado.cantidad.toLocaleString('es-CO')}</td>
						<td style="padding: 1rem; border: 1px solid #e5e7eb; text-align: right;">${formatearMoneda(resultado.costoUnitario)}</td>
						<td style="padding: 1rem; border: 1px solid #e5e7eb; text-align: right;">${formatearMoneda(resultado.costoTotal)}</td>
						<td style="padding: 1rem; border: 1px solid #e5e7eb; text-align: right; font-weight: 600;">${formatearMoneda(resultado.precioVenta)}</td>
						<td style="padding: 1rem; border: 1px solid #e5e7eb; text-align: right; color: #059669;">${formatearMoneda(resultado.utilidad)} (${resultado.porcentajeUtilidad.toFixed(1)}%)</td>
					`;
					tabla.appendChild(fila);
				}
			});

			// Agregar transporte si aplica
			if (resultados.transporte > 0) {
				const fila = document.createElement('tr');
				fila.innerHTML = `
					<td style="padding: 1rem; border: 1px solid #e5e7eb;">Transporte y Logística</td>
					<td style="padding: 1rem; border: 1px solid #e5e7eb; text-align: right;">-</td>
					<td style="padding: 1rem; border: 1px solid #e5e7eb; text-align: right;">-</td>
					<td style="padding: 1rem; border: 1px solid #e5e7eb; text-align: right;">${formatearMoneda(resultados.transporte)}</td>
					<td style="padding: 1rem; border: 1px solid #e5e7eb; text-align: right; font-weight: 600;">${formatearMoneda(resultados.transporte)}</td>
					<td style="padding: 1rem; border: 1px solid #e5e7eb; text-align: right;">-</td>
				`;
				tabla.appendChild(fila);
			}

			// Calcular totales incluyendo transporte
			const subtotalConTransporte = resultados.subtotalSinIva + resultados.transporte;
			const ivaConTransporte = subtotalConTransporte * CONSTANTES.IVA;
			const totalFinal = subtotalConTransporte + ivaConTransporte;

			// Actualizar totales
			document.getElementById('subtotal-sin-iva').textContent = formatearMoneda(subtotalConTransporte);
			document.getElementById('iva-total').textContent = formatearMoneda(ivaConTransporte);
			document.getElementById('total-con-iva').textContent = formatearMoneda(totalFinal);

			// Mostrar contenedor
			container.style.display = 'block';
			container.scrollIntoView({ behavior: 'smooth' });
		}

		// Event listeners
		document.addEventListener('DOMContentLoaded', function() {
			// Botón calcular
			document.getElementById('calcular-btn').addEventListener('click', function() {
				const resultados = calcularCotizacion();
				mostrarResultados(resultados);
			});

			// Mostrar/ocultar campos de alquiler
			document.getElementById('alquilar-andamio').addEventListener('change', function() {
				const container = document.getElementById('dias-andamio-container');
				container.style.display = this.value === 'si' ? 'block' : 'none';
			});

			document.getElementById('alquilar-escalera').addEventListener('change', function() {
				const container = document.getElementById('dias-escalera-container');
				container.style.display = this.value === 'si' ? 'block' : 'none';
			});

			// Botón imprimir
			document.getElementById('imprimir')?.addEventListener('click', function() {
				window.print();
			});

			// Botón nueva cotización
			document.getElementById('nueva-cotizacion')?.addEventListener('click', function() {
				location.reload();
			});

			// Botón exportar PDF
			document.getElementById('exportar-pdf')?.addEventListener('click', function() {
				exportarPDF();
			});
		});
	</script>

	<style>
		@media print {
			Header, Footer, #calcular-btn, #exportar-pdf, #imprimir, #nueva-cotizacion {
				display: none !important;
			}
			
			#cotizador-app {
				max-width: 100% !important;
			}
		}
	</style>
</BaseLayout>

